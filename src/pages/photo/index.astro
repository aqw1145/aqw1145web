---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

import Photo1 from '../../assets/blog-placeholder-1.jpg';
import Photo2 from '../../assets/blog-placeholder-2.jpg';
import Photo3 from '../../assets/blog-placeholder-3.jpg';
import Photo4 from '../../assets/blog-placeholder-4.jpg';
import Photo5 from '../../assets/blog-placeholder-5.jpg';
import Photo6 from '../../assets/blog-placeholder-about.jpg';

// 暂用项目已有的模板图片。替换 import 路径、标题和图片说明即可换成自己的照片。
// 数组的排列顺序就是页面上的显示顺序。
const photos = [
	{ image: Photo1, title: '示例照片 01', alt: '模板示例图片 1' },
	{ image: Photo2, title: '示例照片 02', alt: '模板示例图片 2' },
	{ image: Photo3, title: '示例照片 03', alt: '模板示例图片 3' },
	{ image: Photo4, title: '示例照片 04', alt: '模板示例图片 4' },
	{ image: Photo5, title: '示例照片 05', alt: '模板示例图片 5' },
	{ image: Photo6, title: '示例照片 06', alt: '模板关于页图片' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`照片 | ${SITE_TITLE}`} description="用照片记录生活中的片刻。" />
	</head>
	<body>
		<Header />
		<main>
			<section aria-labelledby="photo-heading">
				<div class="page-intro">
					<h1 id="photo-heading">照片</h1>
					<p>用照片记录生活中的片刻。点击照片，在新标签页查看大图。</p>
				</div>
				<ul class="photo-list">
					{photos.map((photo) => (
						<li>
							<a
								class="photo-link"
								href={photo.image.src}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${photo.title}，在新标签页查看大图`}
							>
								<figure>
									<div class="photo-frame">
										<Image
											class="photo-image"
											src={photo.image}
											alt={photo.alt}
											width={960}
											loading="lazy"
											decoding="async"
										/>
									</div>
									<figcaption>{photo.title}</figcaption>
								</figure>
							</a>
							</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}

	.page-intro {
		margin-bottom: 2rem;
	}

	.page-intro h1 {
		font-size: 2rem;
	}

	.page-intro p {
		margin: 0;
		color: rgb(var(--gray));
	}

	/* 所有照片统一双列，首张也使用相同布局。 */
	.photo-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.photo-list li {
		min-width: 0;
	}

	figure {
		margin: 0;
	}

	.photo-link {
		display: block;
		color: rgb(var(--black));
		text-decoration: none;
	}

	.photo-frame {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 12px;
		background: rgb(var(--gray-light));
		transition: box-shadow 0.2s ease;
	}

	.photo-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.2s ease;
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.4;
		transition: color 0.2s ease;
	}

	.photo-link:hover .photo-frame {
		box-shadow: var(--box-shadow);
	}

	.photo-link:hover .photo-image {
		transform: scale(1.02);
	}

	.photo-link:hover figcaption {
		color: var(--accent);
	}

	.photo-link:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 6px;
		border-radius: 12px;
	}
</style>
