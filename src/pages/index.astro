---
import SpaceLayout from '../layouts/SpaceLayout.astro';
import { home } from '../data/home';
---

<SpaceLayout title={`${home.name} 的个人空间`} description={`${home.bio}${home.intro}`}>
	<main id="main-content" class="home-main">
		<h1 class="home-artwork-title">湖城晚照</h1>
		<figure class="home-artwork">
			<img src="/images/lake-city-afterglow.svg" width="1600" height="1200" alt="湖城晚照插画：夕阳下的湖面、城市天际线和古塔，前景是荷花、黑天鹅与三花猫。" loading="eager" fetchpriority="high" decoding="async" />
		</figure>
	</main>
</SpaceLayout>
