---
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import SpaceLayout from '../../layouts/SpaceLayout.astro';
import { home } from '../../data/home';
import '../../styles/blog.css';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<SpaceLayout title={`文章 | ${home.name} 的个人空间`} description="技术笔记与生活随笔，记录想法、探索与日常。" bodyClass="blog-page">
	<main id="main-content" class="blog-main">
		<div class="blog-toolbar">
			<div class="blog-filters" role="group" aria-label="文章分类" data-blog-filters hidden>
				<button type="button" data-category-filter="" aria-pressed="true" aria-controls="blog-posts">全部文章</button>
				{categories.map((category) => <button type="button" data-category-filter={category} aria-pressed="false" aria-controls="blog-posts">{category}</button>)}
			</div>
			<p class="blog-count" aria-live="polite" aria-atomic="true" data-blog-count>共 {posts.length} 篇文章</p>
		</div>
		{posts.length > 0 ? (
			<ul class="blog-grid" id="blog-posts" aria-label="文章列表">
				{posts.map((post, index) => <li class="blog-item" data-post-category={post.data.category}><BlogCard post={post} eager={index === 0} /></li>)}
			</ul>
		) : (
			<div class="blog-empty" id="blog-posts"><span aria-hidden="true">✳</span><h2>第一篇文章，还在酝酿中。</h2><p>想法会慢慢积累，故事也会。</p></div>
		)}
	</main>
</SpaceLayout>

<script>
	const filters = document.querySelector<HTMLElement>('[data-blog-filters]');
	const count = document.querySelector<HTMLElement>('[data-blog-count]');
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-post-category]'));
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
	if (filters && items.length > 0) {
		filters.hidden = false;
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const category = button.dataset.categoryFilter ?? '';
				let visible = 0;
				items.forEach((item) => {
					const matches = category === '' || item.dataset.postCategory === category;
					item.hidden = !matches;
					if (matches) visible++;
				});
				buttons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
				if (count) count.textContent = category ? `${category} · ${visible} 篇文章` : `共 ${visible} 篇文章`;
			});
		});
	}
</script>
