---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SpaceIcon from '../components/SpaceIcon.astro';
import SpaceLayout from './SpaceLayout.astro';
import { home } from '../data/home';
import '../styles/blog.css';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };
const { title, description, category, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<SpaceLayout title={`${title} | ${home.name}`} description={description} image={heroImage} bodyClass="blog-page">
	<main id="main-content" class="blog-main blog-detail">
		<a class="blog-back" href="/blog/"><SpaceIcon name="left" />返回文章列表</a>
		<header class="blog-post-header">
			<div class="blog-post-meta"><span class="blog-category">{category}</span><span aria-hidden="true">·</span><FormattedDate date={pubDate} />{updatedDate && <span class="blog-updated">更新于 <FormattedDate date={updatedDate} /></span>}</div>
			<h1>{title}</h1><p class="blog-description">{description}</p>
			<div class="blog-author"><span class="blog-author-avatar" aria-hidden="true">{home.initial}</span><span>{home.name}</span><span class="blog-author-separator" aria-hidden="true">/</span><span>{home.bio}</span></div>
		</header>
		<div class:list={['blog-reading-grid', { 'without-toc': toc.length === 0 }]}>
			<article class="blog-prose" aria-label="文章正文">
				{heroImage && <figure class="blog-hero-image"><Image src={heroImage} alt="" width={1200} height={675} loading="eager" decoding="async" /></figure>}
				<slot />
				<div class="blog-post-end"><span aria-hidden="true">✳</span><span>感谢阅读，下一篇见。</span><a href="/blog/">更多文章 <SpaceIcon name="arrow" /></a></div>
			</article>
			<aside class="blog-toc" aria-label="文章目录" data-article-outline hidden={toc.length === 0}><details open data-article-toc><summary>本文目录 <SpaceIcon name="chevron" /></summary><nav aria-label="章节导航"><ol data-toc-links>{toc.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav><p>慢慢读，不着急。</p></details></aside>
		</div>
	</main>
</SpaceLayout>

<script>
	// Markdown 提供初始目录；再读取真实正文，补齐直接写入的 HTML / MDX 标题。
	const outline = document.querySelector<HTMLElement>('[data-article-outline]');
	const links = document.querySelector<HTMLOListElement>('[data-toc-links]');
	const sections = Array.from(document.querySelectorAll<HTMLHeadingElement>('.blog-prose h2, .blog-prose h3'));
	if (outline && links) {
		const reserved = new Set(Array.from(document.querySelectorAll<HTMLElement>('[id]'), (element) => element.id));
		const items = document.createDocumentFragment();
		sections.forEach((heading, index) => {
			if (!heading.id) {
				const base = `article-section-${index + 1}`;
				let id = base;
				let suffix = 1;
				while (reserved.has(id)) id = `${base}-${suffix++}`;
				heading.id = id;
				reserved.add(id);
			}
			const item = document.createElement('li');
			if (heading.tagName === 'H3') item.className = 'toc-subheading';
			const link = document.createElement('a');
			link.href = `#${heading.id}`;
			link.textContent = heading.textContent;
			item.append(link);
			items.append(item);
		});
		links.replaceChildren(items);
		outline.hidden = sections.length === 0;
		document.querySelector('.blog-reading-grid')?.classList.toggle('without-toc', sections.length === 0);
	}
	const toc = document.querySelector<HTMLDetailsElement>('[data-article-toc]');
	if (toc && window.matchMedia('(max-width: 800px)').matches) toc.open = false;
</script>
