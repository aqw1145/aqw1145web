---
interface Props {
	src: string;
	width: number;
	height: number;
	alt: string;
}
const { src, width, height, alt } = Astro.props;
---

<photo-zoom class="album-zoom">
	<div class="album-zoom-toolbar" role="group" aria-label="照片缩放" data-zoom-toolbar hidden>
		<button type="button" data-zoom-out aria-label="缩小照片" aria-controls="photo-zoom-viewport">−</button>
		<output data-zoom-level aria-label="照片缩放比例" aria-live="polite" aria-atomic="true">100%</output>
		<button type="button" data-zoom-in aria-label="放大照片" aria-controls="photo-zoom-viewport">＋</button>
		<button type="button" class="album-zoom-reset" data-zoom-reset aria-controls="photo-zoom-viewport">重置</button>
	</div>
	<figure id="photo-zoom-viewport" class="album-detail-image" data-zoom-viewport>
		<img class="album-detail-photo" src={src} width={width} height={height} alt={alt} loading="eager" decoding="async" draggable="false" />
	</figure>
	<p id="photo-zoom-help" class="album-zoom-help" data-zoom-help hidden>放大后可拖动查看；双击照片放大或还原。聚焦图片后可用 + / − 缩放、0 重置、方向键移动。</p>
</photo-zoom>

<script>
	class PhotoZoom extends HTMLElement {
		private cleanup?: () => void;

		connectedCallback() {
			if (this.cleanup) return;
			const viewport = this.querySelector<HTMLElement>('[data-zoom-viewport]')!;
			const image = this.querySelector<HTMLImageElement>('img')!;
			const toolbar = this.querySelector<HTMLElement>('[data-zoom-toolbar]')!;
			const help = this.querySelector<HTMLElement>('[data-zoom-help]')!;
			const zoomOut = this.querySelector<HTMLButtonElement>('[data-zoom-out]')!;
			const zoomIn = this.querySelector<HTMLButtonElement>('[data-zoom-in]')!;
			const reset = this.querySelector<HTMLButtonElement>('[data-zoom-reset]')!;
			const level = this.querySelector<HTMLOutputElement>('[data-zoom-level]')!;
			const imageWidth = Number(image.getAttribute('width'));
			const imageHeight = Number(image.getAttribute('height'));
			const controller = new AbortController();
			const options = { signal: controller.signal };
			let scale = 1;
			let x = 0;
			let y = 0;
			let fittedWidth = 0;
			let fittedHeight = 0;
			let lastWidth = 0;
			let drag: { id: number; x: number; y: number } | undefined;
			const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

			const render = () => {
				x = clamp(x, Math.max(0, (fittedWidth * scale - viewport.clientWidth) / 2));
				y = clamp(y, Math.max(0, (fittedHeight * scale - viewport.clientHeight) / 2));
				this.style.setProperty('--album-zoom-scale', String(scale));
				this.style.setProperty('--album-zoom-x', `${x}px`);
				this.style.setProperty('--album-zoom-y', `${y}px`);
				this.classList.toggle('is-zoomed', scale > 1);
				const label = `${Math.round(scale * 100)}%`;
				if (level.textContent !== label) level.textContent = label;
				zoomOut.disabled = scale <= .5;
				zoomIn.disabled = scale >= 3;
				reset.disabled = scale === 1 && x === 0 && y === 0;
			};
			const stopDragging = () => {
				const pointer = drag?.id;
				drag = undefined;
				this.classList.remove('is-dragging');
				if (pointer !== undefined && viewport.hasPointerCapture(pointer)) viewport.releasePointerCapture(pointer);
			};
			const setScale = (value: number) => {
				stopDragging();
				scale = Math.max(.5, Math.min(3, Math.round(value * 100) / 100));
				if (scale <= 1) x = y = 0;
				render();
			};
			const fit = () => {
				if (!viewport.clientWidth) return;
				stopDragging();
				lastWidth = viewport.clientWidth;
				const ratio = Math.min(lastWidth / imageWidth, window.innerHeight * .7 / imageHeight);
				fittedWidth = imageWidth * ratio;
				fittedHeight = imageHeight * ratio;
				this.style.setProperty('--album-zoom-width', `${fittedWidth}px`);
				this.style.setProperty('--album-zoom-height', `${fittedHeight}px`);
				render();
			};

			zoomOut.addEventListener('click', () => setScale(scale - .25), options);
			zoomIn.addEventListener('click', () => setScale(scale + .25), options);
			reset.addEventListener('click', () => { x = y = 0; setScale(1); }, options);
			viewport.addEventListener('dblclick', () => setScale(scale > 1 ? 1 : 2), options);
			viewport.addEventListener('keydown', (event) => {
				if (event.ctrlKey || event.metaKey || event.altKey) return;
				if (event.key === '+' || event.key === '=') setScale(scale + .25);
				else if (event.key === '-' || event.key === '_') setScale(scale - .25);
				else if (event.key === '0') { x = y = 0; setScale(1); }
				else if (scale > 1 && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
					x += event.key === 'ArrowLeft' ? 40 : event.key === 'ArrowRight' ? -40 : 0;
					y += event.key === 'ArrowUp' ? 40 : event.key === 'ArrowDown' ? -40 : 0;
					render();
				} else return;
				event.preventDefault();
			}, options);
			viewport.addEventListener('pointerdown', (event) => {
				if (scale <= 1 || drag || event.button !== 0) return;
				event.preventDefault();
				drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
				viewport.setPointerCapture(event.pointerId);
				viewport.focus({ preventScroll: true });
				this.classList.add('is-dragging');
			}, options);
			viewport.addEventListener('pointermove', (event) => {
				if (!drag || event.pointerId !== drag.id) return;
				x += event.clientX - drag.x;
				y += event.clientY - drag.y;
				drag.x = event.clientX;
				drag.y = event.clientY;
				render();
			}, options);
			for (const eventName of ['pointerup', 'pointercancel', 'lostpointercapture'] as const) {
				viewport.addEventListener(eventName, (event) => {
					if (event.pointerId === drag?.id) stopDragging();
				}, options);
			}
			const observer = new ResizeObserver(() => {
				if (Math.abs(viewport.clientWidth - lastWidth) > .5) fit();
			});
			observer.observe(viewport);
			window.addEventListener('resize', fit, options);
			viewport.tabIndex = 0;
			viewport.setAttribute('role', 'group');
			viewport.setAttribute('aria-label', '照片缩放区域');
			viewport.setAttribute('aria-describedby', 'photo-zoom-help');
			toolbar.hidden = help.hidden = false;
			this.classList.add('is-ready');
			fit();
			this.cleanup = () => {
				stopDragging();
				controller.abort();
				observer.disconnect();
				toolbar.hidden = help.hidden = true;
				this.classList.remove('is-ready', 'is-zoomed');
			};
		}

		disconnectedCallback() {
			this.cleanup?.();
			this.cleanup = undefined;
		}
	}
	if (!customElements.get('photo-zoom')) customElements.define('photo-zoom', PhotoZoom);
</script>
